{
  "redirects": [
    { "source": "/rss", "destination": "/rss.xml", "statusCode": 301 },
    { "source": "/feed", "destination": "/rss.xml", "statusCode": 301 },
    { "source": "/feed.xml", "destination": "/rss.xml", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/((?!assets/|rss\\.xml|sitemap\\.xml|favicon\\.webp|.*\\.pdf|.*\\.jpeg|.*\\.png).*)", "destination": "/index.html" }
  ]
}
